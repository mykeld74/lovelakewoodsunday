# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend — emails contact + volunteer form submissions
# https://resend.com/api-keys  (verify your domain first)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Love Lakewood Sunday <noreply@lovelakewoodsunday.org>"
# Comma-separated recipients. Falls back to site.contactEmail if empty.
NOTIFY_EMAIL="hello@lovelakewoodsunday.org"
